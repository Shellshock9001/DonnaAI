# Docker Secrets Template
# Copy this file and rename to .docker-secrets
# Use docker secrets in production for sensitive data

# Database
POSTGRES_USER=donna_user
POSTGRES_PASSWORD=changeme-strong-password-here
POSTGRES_DB=donna_ai

# JWT Secrets (generate strong random strings)
JWT_SECRET=your-jwt-secret-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production

# API Keys
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
TAVILY_API_KEY=your-tavily-api-key
APOLLO_API_KEY=your-apollo-api-key

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-strong-password-here

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production

